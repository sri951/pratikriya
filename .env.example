# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_SUPABASE_PROJECT_ID=your-project-id

# AI Gateway (Backend / Server Functions)
LOVABLE_API_KEY=your-lovable-api-key-here

# n8n Orchestration Layer Configuration
# For local development: http://localhost:5678
# For cloud/production: https://your-n8n-instance.com
VITE_N8N_BASE_URL=http://localhost:5678
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_SECRET=your-webhook-secret-token

# n8n Docker Setup Environment (Used by docker-compose)
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=pratikriya_admin_secure_password
WEBHOOK_URL=http://localhost:5678/
N8N_PORT=5678
